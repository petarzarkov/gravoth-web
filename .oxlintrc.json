{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-inferrable-types": "off",
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "prefer-const": "error",
    "max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.e2e.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 800,
            "skipBlankLines": true
          }
        ],
        "typescript/await-thenable": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist",
    "**/coverage",
    "**/node_modules",
    "**/.tmp",
    "**/*.d.ts",
    "apps/server/drizzle"
  ]
}
