# The names the server reads from .env beside compose.prod.yml (on the Pi: ~/gravoth/web/.env). Copy to .env and fill in;
# .env is never committed and never copied into the image. Everything else (hosts, the database user, the public URL) is set
# in compose.prod.yml. For local development, apps/server/.env takes the same names (all optional there).

# better-auth's signing secret: 32 characters or more (openssl rand -base64 48). Required in production.
AUTH_SECRET=

# The database password, read by both the database and the app (openssl rand -hex 32). Required; set it before the first
# start, since Postgres takes it only when its volume is first made.
POSTGRES_PASSWORD=

# The Cloudflare Tunnel's token (Zero Trust, Networks, Tunnels), for the `tunnel` profile.
TUNNEL_TOKEN=

# Google: the Web application OAuth client in the game's Google Cloud project. Both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: the application's OAuth2 client (Discord Developer Portal). Both or neither.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Resend: an API key with sending access to mail.petarzarkov.com. Unset: mails are only logged.
RESEND_API_KEY=
# Optional: the sender (default Gravoth <no-reply@mail.petarzarkov.com>).
# MAIL_FROM=

# The nightly backup's Cloudflare R2 bucket and an R2 API token with Object Read & Write on it. All four or none.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: another S3 endpoint instead of R2's (only the end-to-end run's mock sets it).
# R2_ENDPOINT=
# Optional: days a backup is kept (default 30).
# BACKUP_KEEP_DAYS=

# Optional: the public origin (default https://gravoth-api.petarzarkov.com): the website, the API, mail links and the OAuth
# redirect URIs are all on it. CORS_ORIGIN: a second trusted origin, for the website's dev server (http://localhost:3001)
# or a site hosted apart from the API.
# PUBLIC_URL=
# CORS_ORIGIN=
