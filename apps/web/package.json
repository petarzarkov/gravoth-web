  },
  "dependencies": {
    "@gravoth/contracts": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  }
}
